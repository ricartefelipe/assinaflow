# Spring / app
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080
PORT=8080

# PostgreSQL
DB_URL=jdbc:postgresql://postgres:5432/subscriptions
DB_USERNAME=subscriptions
DB_PASSWORD=subscriptions

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RABBIT_HOST=rabbitmq
RABBIT_PORT=5672
RABBIT_USERNAME=guest
RABBIT_PASSWORD=guest

# Feature flags
APP_SCHEDULER_ENABLED=true
APP_PAYMENTS_ASYNC_ENABLED=true

# Optional schedulers / outbox (defaults match application.yml)
# APP_OUTBOX_PUBLISHER_CRON=*/2 * * * * *
# APP_OUTBOX_PUBLISHER_BATCH=100
# APP_OUTBOX_PUBLISHER_MAX_ATTEMPTS=10
# APP_RENEWAL_CRON=0 */5 * * * *
# APP_CANCELLATION_CRON=0 10 0 * * *

# Optional Rabbit routing (profile docker)
# APP_PAYMENTS_EXCHANGE=payments.exchange
# APP_PAYMENTS_QUEUE=payments.charge
# APP_PAYMENTS_ROUTING_KEY=payments.charge

# --- Railway notes ---
# Railway injects PORT; Spring binds via server.port (${PORT} then ${SERVER_PORT}).
# Point DB_URL / REDIS_* / RABBIT_* at Railway Postgres, Redis and RabbitMQ
# (or equivalent) private hostnames and credentials from those services.
